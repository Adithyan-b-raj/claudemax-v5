PORT=3000
ADMIN_SECRET=your-admin-secret-here
AWS_BEARER_TOKEN_BEDROCK=your-aws-bearer-token
AWS_REGION=us-east-1
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-6

# ── Request Queue (throttle control) ─────────────────────────────────────────
# Minimum delay (ms) between outbound Bedrock requests.
# Set higher if your quota is very low (e.g. 10 RPM → use 6000).
BEDROCK_QUEUE_INTERVAL_MS=500
# Max simultaneous Bedrock requests allowed at once.
BEDROCK_QUEUE_CONCURRENCY=2
